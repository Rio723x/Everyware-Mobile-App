# Copy to .env beside docker-compose.yml and fill in. Never commit .env.

# The public origin Ghost serves on, and the bare domain Caddy issues TLS for.
GHOST_PUBLIC_URL=https://cms.everyware.in
GHOST_DOMAIN=cms.everyware.in

# Generate both with: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Optional. Without these Ghost still runs, but staff invites and password
# resets cannot be emailed - you invite users by copying the link from the logs.
MAIL_SERVICE=
MAIL_USER=
MAIL_PASSWORD=
