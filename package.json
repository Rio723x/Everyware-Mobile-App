{
  "name": "everyware",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Everyware website monorepo: React/Vite marketing app, Astro blog, and SEO tooling.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:site": "npm run dev -w apps/site",
    "dev:blog": "echo \"apps/blog does not exist yet - see tickets/01-foundation/007-astro-scaffold.md\" && exit 1",
    "build": "npm run build -w apps/site",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
