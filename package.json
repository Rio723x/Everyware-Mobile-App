{
  "name": "everyware",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Everyware website monorepo: React/Vite marketing app, Astro blog, and SEO tooling.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:site": "npm run dev -w apps/site",
    "dev:blog": "npm run dev -w apps/blog",
    "build": "npm run build -w apps/site",
    "typecheck": "tsc -b && npm run astro-check -w apps/blog",
    "test": "npm run build -w apps/blog && vitest run",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
