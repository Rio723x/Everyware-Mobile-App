# ── Build time (the Astro blog build reads these) ──────────────────────────
# Ghost Content API. Absent locally => the blog builds from fixtures.
# A production build with these missing fails loudly rather than deploying an
# empty blog.
GHOST_CONTENT_API_URL=https://cms.everyware.in
GHOST_CONTENT_API_KEY=

# Canonical origin used for canonical URLs, sitemap and OpenGraph.
PUBLIC_SITE_URL=https://everyware.in

# ── Runtime (the SEO worker's Vercel functions read these) ─────────────────
# Everything below is needed only by api/webhooks/ghost.ts and api/seo/*.
# The blog builds and deploys correctly without any of it.

# Shared secret for Ghost's webhook signatures. The same value must be set on
# each of the four webhooks in the Ghost integration. Generate with:
#   openssl rand -hex 32
GHOST_WEBHOOK_SECRET=

# Bearer token guarding api/seo/process and api/seo/report. Generate with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SEO_WORKER_TOKEN=

# Google AI Studio key for the advisory analysis step (free tier is sufficient;
# the worker caps itself at 20 analyses per hour). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Vercel deploy hook on the production branch, called after a Ghost change.
# Vercel dashboard -> Settings -> Git -> Deploy Hooks.
VERCEL_DEPLOY_HOOK_URL=

# Report and idempotency store. "file" is the default and is right for local
# use; serverless has no persistent disk, so deployments must use "redis".
# Setting redis without the two values below throws at startup, on purpose.
SEO_STORE_DRIVER=file

# Upstash-dialect REST endpoint. Self-hosted on the Ghost VM behind
# serverless-redis-http - see infra/redis/README.md. Hosted Upstash is a
# drop-in replacement for these two values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
