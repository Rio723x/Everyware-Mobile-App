---
import type { GetStaticPaths } from "astro";
import type { BlogPost, BlogTag } from "@everyware/ghost";
import { buildPageMetadata } from "@everyware/seo-core";
import Breadcrumbs from "../../../../../components/Breadcrumbs.astro";
import SeoHead from "../../../../../components/SeoHead.astro";
import DownloadCtaBand from "../../../../../components/DownloadCtaBand.astro";
import Pagination from "../../../../../components/Pagination.astro";
import PostGrid from "../../../../../components/PostGrid.astro";
import BlogLayout from "../../../../../layouts/BlogLayout.astro";
import { categoryTrail } from "../../../../../lib/breadcrumbs";
import { ghost } from "../../../../../lib/content";
import { extraPageNumbers, paginate } from "../../../../../lib/pagination";

/** Pages 2..n only; page 1 is /blog/category/<slug>. */
export const getStaticPaths: GetStaticPaths = async () => {
  const tags = await ghost.listTags();
  const routes = await Promise.all(
    tags.map(async (tag) => {
      const posts = await ghost.listPostsByTag(tag.slug);
      return extraPageNumbers(posts.length).map((page) => ({
        params: { slug: tag.slug, page: String(page) },
        props: { tag, posts, pageNumber: page },
      }));
    }),
  );
  return routes.flat();
};

interface Props {
  readonly tag: BlogTag;
  readonly posts: readonly BlogPost[];
  readonly pageNumber: number;
}

const { tag, posts, pageNumber } = Astro.props satisfies Props;
const page = paginate(posts, pageNumber, `/blog/category/${tag.slug}`);

const trail = categoryTrail(tag);
const metadata = buildPageMetadata(
  { kind: "category", tag, postCount: posts.length, page: page.page, totalPages: page.totalPages },
  trail,
);
---

<BlogLayout>
  <SeoHead slot="head" metadata={metadata} />

  <div class="container">
    <Breadcrumbs trail={trail} />

    <header class="collection-header">
      <h1 class="blog-h1">{tag.name}</h1>
      <p class="blog-lead">Page {page.page} of {page.totalPages}</p>
    </header>

    <PostGrid posts={page.items} />

    <Pagination
      page={page.page}
      totalPages={page.totalPages}
      prevHref={page.prevHref}
      nextHref={page.nextHref}
    />

    <DownloadCtaBand />
  </div>
</BlogLayout>

<style>
  .collection-header {
    margin: 28px 0 8px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
</style>
