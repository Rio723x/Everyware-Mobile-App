---
import type { GetStaticPaths } from "astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DownloadCtaBand from "../../../components/DownloadCtaBand.astro";
import Pagination from "../../../components/Pagination.astro";
import PostGrid from "../../../components/PostGrid.astro";
import SeoHead from "../../../components/SeoHead.astro";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import { buildPageMetadata } from "@everyware/seo-core";
import { listingTrail } from "../../../lib/breadcrumbs";
import { ghost } from "../../../lib/content";
import { extraPageNumbers, paginate } from "../../../lib/pagination";

/**
 * Pages 2..n only. Page 1 lives at /blog, and generating /blog/page/1 as well
 * would put identical content on two URLs.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await ghost.listPosts();
  return extraPageNumbers(posts.length).map((page) => ({
    params: { page: String(page) },
  }));
};

const posts = await ghost.listPosts();
const pageNumber = Number(Astro.params.page);
const page = paginate(posts, pageNumber, "/blog");

const trail = listingTrail();
const metadata = buildPageMetadata(
  { kind: "listing", page: page.page, totalPages: page.totalPages },
  trail,
);
---

<BlogLayout>
  <SeoHead slot="head" metadata={metadata} />

  <div class="container">
    <Breadcrumbs trail={trail} />

    <header class="listing-header">
      <h1 class="blog-h1">Everyware Blog</h1>
      <p class="blog-lead">Page {page.page} of {page.totalPages}</p>
    </header>

    <PostGrid posts={page.items} />

    <Pagination
      page={page.page}
      totalPages={page.totalPages}
      prevHref={page.prevHref}
      nextHref={page.nextHref}
    />

    <DownloadCtaBand />
  </div>
</BlogLayout>

<style>
  .listing-header {
    margin: 28px 0 8px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
</style>
