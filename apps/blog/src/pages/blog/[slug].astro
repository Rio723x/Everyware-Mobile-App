---
import type { GetStaticPaths } from "astro";
import type { BlogPost } from "@everyware/ghost";
import { buildPageMetadata, prepareArticleHtml } from "@everyware/seo-core";
import AuthorByline from "../../components/AuthorByline.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import TagChips from "../../components/TagChips.astro";
import DownloadCtaBand from "../../components/DownloadCtaBand.astro";
import SeoHead from "../../components/SeoHead.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { articleTrail } from "../../lib/breadcrumbs";
import { ghost } from "../../lib/content";
import { relatedPosts } from "../../lib/related";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await ghost.listPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
};

/**
 * `GetStaticPaths` does not propagate the props type to `Astro.props`, so the
 * shape is declared here. Without it `post` arrives as `unknown` and every
 * access below is an error rather than a checked field.
 */
interface Props {
  readonly post: BlogPost;
}

const { post } = Astro.props satisfies Props;

/**
 * Validates and transforms the Ghost body: refuses an <h1> or a skipped heading
 * level, and adds lazy-loading hints to body images. A structural problem fails
 * the build naming the slug rather than shipping a page with two h1s.
 */
const body = prepareArticleHtml(post.html, post.slug);

/**
 * The hero is the largest contentful paint on nearly every article page, so it
 * is the one image loaded eagerly. Width and height declare the 1200x630 box
 * the CSS reserves - see PostCard for why that is the right use of those
 * attributes on a remote image.
 */
const HERO_WIDTH = 1200;
const HERO_HEIGHT = 630;

const related = relatedPosts(post, await ghost.listPosts());

const trail = articleTrail(post);
const metadata = buildPageMetadata({ kind: "article", post }, trail);
---

<BlogLayout>
  <SeoHead slot="head" metadata={metadata} />

  <div class="container">
    <Breadcrumbs trail={trail} />

    <article class="article">
      <header class="article-header">
        <h1 class="blog-h1">{post.title}</h1>
        <AuthorByline post={post} />
      </header>

      {
        post.featureImage !== null && (
          <img
            class="article-hero"
            src={post.featureImage.url}
            alt={post.featureImage.alt}
            width={HERO_WIDTH}
            height={HERO_HEIGHT}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        )
      }

      <p class="article-summary">{post.excerpt}</p>

      <div class="article-body" set:html={body} />

      <footer class="article-footer">
        <TagChips tags={post.tags} />
      </footer>
    </article>

    <RelatedPosts posts={related} />
    <DownloadCtaBand />
  </div>
</BlogLayout>

<style>
  .article {
    margin: 28px 0 0;
  }

  .article-header {
    max-width: 72ch;
    margin: 0 auto 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .article-hero {
    width: 100%;
    max-width: 900px;
    margin: 0 auto 32px;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .article-summary {
    max-width: 72ch;
    margin: 0 auto 32px;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-muted);
    font-weight: 700;
    border-left: 3px solid var(--brand-cyan);
    padding-left: 18px;
  }

  .article-footer {
    max-width: 72ch;
    margin: 40px auto 0;
    padding-top: 24px;
    border-top: 1px solid color-mix(in srgb, var(--brand-ink) 10%, transparent);
  }
</style>
