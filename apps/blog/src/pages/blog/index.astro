---
// Temporary scaffold page, now rendering inside BlogLayout so the chrome is
// exercised end to end. T-01-011 replaces it with the real listing.
import BlogLayout from "../../layouts/BlogLayout.astro";
import { ghost } from "../../lib/content";

const posts = await ghost.listPosts();
---

<BlogLayout>
  <div class="container">
    <h1 class="blog-h1">Everyware Blog</h1>
    <p class="blog-lead">
      Appliance care, repair costs and buying guides for Indian households.
    </p>
    <ul>
      {posts.map((post) => <li>{post.title}</li>)}
    </ul>
  </div>
</BlogLayout>
